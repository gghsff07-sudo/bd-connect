<?xml version="1.0" encoding="utf-8"?>
<!-- Large widget layout: text left, 58dp ring right. See soft_day_widget.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_card_bg"
        android:paddingStart="18dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DB MONITOR"
                android:textColor="@color/widget_accent"
                android:textSize="12sp"
                android:letterSpacing="0.18"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/widget_pending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="No pending items"
                android:textColor="@color/widget_heading"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/widget_latest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="no messages yet"
                android:textColor="@color/widget_muted"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/widget_updated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="updated just now"
                android:textColor="@color/widget_accent"
                android:textSize="12.5sp"/>
        </LinearLayout>

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp">

            <ProgressBar
                android:id="@+id/widget_ring"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:progressDrawable="@drawable/widget_ring"
                android:max="900"
                android:progress="900"
                android:indeterminate="false"/>

            <TextView
                android:id="@+id/widget_countdown"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="15:00"
                android:textColor="@color/widget_heading"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
