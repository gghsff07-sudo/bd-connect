<?xml version="1.0" encoding="utf-8"?>
<!--
  Soft Day themed real-time home-screen widget.
  Cream rounded card (#F8F4EE), terracotta ring (#C0684F), charcoal heading
  (#2E2A26), warm gray labels (#8A8078).
  SoftDayWidgetProvider re-renders this every second: the countdown ticks,
  the progress ring drains, and "updated Ns ago" counts up from lastUpdateMs.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_card_bg"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Countdown ring, draining in real time -->
        <FrameLayout
            android:layout_width="62dp"
            android:layout_height="62dp">

            <ProgressBar
                android:id="@+id/widget_ring"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:progressDrawable="@drawable/widget_ring"
                android:max="900"
                android:progress="900"
                android:indeterminate="false"/>

            <TextView
                android:id="@+id/widget_countdown"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="15:00"
                android:textColor="@color/widget_heading"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DB MONITOR"
                android:textColor="@color/widget_accent"
                android:textSize="10sp"
                android:letterSpacing="0.18"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/widget_pending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="No pending items"
                android:textColor="@color/widget_heading"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/widget_latest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="no messages yet"
                android:textColor="@color/widget_muted"
                android:textSize="12sp"/>

            <!-- Real-time "updated Ns ago" label -->
            <TextView
                android:id="@+id/widget_updated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="updated just now"
                android:textColor="@color/widget_accent"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
