+import 'package:home_widget/home_widget.dart';
+import 'storage_service.dart';
+
+/// Bridges app state to the Android home-screen widget via home_widget.
+/// The native widget (SoftDayWidgetProvider) reads these values from
+/// SharedPreferences and renders the Soft Day themed card.
+class WidgetService {
+  static const _widgetName = 'DbMonitorWidget';
+
+  /// Push the current state so the widget re-renders.
+  static Future<void> updateWidget() async {
+    try {
+      final s = StorageService();
+      final items = await s.loadItems();
+      final pending = items.where((i) => !i.done).length;
+      final lastPoll = await s.getLastPoll();
+      final lastPollLabel = lastPoll == null
+          ? 'not checked yet'
+          : 'last: ${_two(lastPoll.hour)}:${_two(lastPoll.minute)}';
+
+      // Next check timestamp (ms) so the widget computes its own countdown
+      // and keeps ticking even when the Flutter engine is not running.
+      final nextCheckMs = (lastPoll ?? DateTime.now())
+          .add(const Duration(minutes: 15))
+          .millisecondsSinceEpoch;
+
+      final latestTitle = items.isEmpty ? 'No items yet' : items.first.title;
+      final latestType = items.isEmpty ? 'info' : items.first.type;
+
+      await HomeWidget.saveWidgetData('pending', pending);
+      await HomeWidget.saveWidgetData('lastPollLabel', lastPollLabel);
+      await HomeWidget.saveWidgetData('nextCheckMs', nextCheckMs);
+      await HomeWidget.saveWidgetData('latestTitle', latestTitle);
+      await HomeWidget.saveWidgetData('latestType', latestType);
+      await HomeWidget.saveWidgetData('lastUpdateMs',
+          DateTime.now().millisecondsSinceEpoch);
+      await HomeWidget.updateWidget(
+          androidName: _widgetName);
+    } catch (_) {
+      // Widget is optional polish - never let it break the app.
+    }
+  }
+
+  static String _two(int n) => n.toString().padLeft(2, '0');
+
+  /// Called from MainActivity when the user taps the widget body.
+  static Future<void> handleWidgetClicked(Uri? uri) async {
+    // Simply opening the app is enough - HomeScreen refreshes on resume.
+  }
+}
