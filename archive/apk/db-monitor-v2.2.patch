+import 'dart:convert';
+import 'package:shared_preferences/shared_preferences.dart';
+import '../models/monitor_item.dart';
+
+/// Local persistence: items, connection settings, last poll time, badge count.
+/// Everything is optional and guarded - a fresh install with no config is valid.
+class StorageService {
+  StorageService._();
+  static final StorageService _i = StorageService._();
+  factory StorageService() => _i;
+
+  static const _kItems = 'monitor_items';
+  static const _kApiUrl = 'api_url';
+  static const _kFbUrl = 'firebase_url';
+  static const _kFbPath = 'firebase_path';
+  static const _kLastPoll = 'last_poll';
+
+  Future<List<MonitorItem>> loadItems() async {
+    try {
+      final p = await SharedPreferences.getInstance();
+      final raw = p.getString(_kItems);
+      if (raw == null || raw.isEmpty) return [];
+      final list = jsonDecode(raw) as List;
+      return list
+          .map((e) => MonitorItem.fromJson(e as Map<String, dynamic>))
+          .toList();
+    } catch (_) {
+      return [];
+    }
+  }
+
+  Future<void> saveItems(List<MonitorItem> items) async {
+    try {
+      final p = await SharedPreferences.getInstance();
+      await p.setString(
+          _kItems, jsonEncode(items.map((e) => e.toJson()).toList()));
+    } catch (_) {}
+  }
+
+  Future<String> getApiUrl() async {
+    try {
+      return (await SharedPreferences.getInstance()).getString(_kApiUrl) ?? '';
+    } catch (_) {
+      return '';
+    }
+  }
+
+  Future<void> setApiUrl(String v) async {
+    try {
+      await (await SharedPreferences.getInstance()).setString(_kApiUrl, v);
+    } catch (_) {}
+  }
+
+  Future<String> getFirebaseUrl() async {
+    try {
+      return (await SharedPreferences.getInstance()).getString(_kFbUrl) ?? '';
+    } catch (_) {
+      return '';
+    }
+  }
+
+  Future<void> setFirebaseUrl(String v) async {
+    try {
+      await (await SharedPreferences.getInstance()).setString(_kFbUrl, v);
+    } catch (_) {}
+  }
+
+  Future<String> getFirebasePath() async {
+    try {
+      return (await SharedPreferences.getInstance()).getString(_kFbPath) ?? '';
+    } catch (_) {
+      return '';
+    }
+  }
+
+  Future<void> setFirebasePath(String v) async {
+    try {
+      await (await SharedPreferences.getInstance()).setString(_kFbPath, v);
+    } catch (_) {}
+  }
+
+  Future<DateTime?> getLastPoll() async {
+    try {
+      final p = await SharedPreferences.getInstance();
+      final raw = p.getString(_kLastPoll);
+      if (raw == null) return null;
+      return DateTime.tryParse(raw);
+    } catch (_) {
+      return null;
+    }
+  }
+
+  Future<void> setLastPoll(DateTime t) async {
+    try {
+      await (await SharedPreferences.getInstance())
+          .setString(_kLastPoll, t.toIso8601String());
+    } catch (_) {}
+  }
+}
