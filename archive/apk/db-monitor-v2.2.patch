+import 'dart:convert';
+
+/// One monitored database event shown in history / detail / notifications.
+class MonitorItem {
+  final String id;
+  final String title;
+  final String body;
+  final String type; // alert | warning | info | success (unknown -> info)
+  final DateTime createdAt;
+  final bool done;
+  final bool seen;
+  final String? source; // 'api' | 'firebase' | 'preview'
+
+  const MonitorItem({
+    required this.id,
+    required this.title,
+    required this.body,
+    required this.type,
+    required this.createdAt,
+    this.done = false,
+    this.seen = false,
+    this.source,
+  });
+
+  MonitorItem copyWith({
+    String? id,
+    String? title,
+    String? body,
+    String? type,
+    DateTime? createdAt,
+    bool? done,
+    bool? seen,
+    String? source,
+  }) =>
+      MonitorItem(
+        id: id ?? this.id,
+        title: title ?? this.title,
+        body: body ?? this.body,
+        type: type ?? this.type,
+        createdAt: createdAt ?? this.createdAt,
+        done: done ?? this.done,
+        seen: seen ?? this.seen,
+        source: source ?? this.source,
+      );
+
+  Map<String, dynamic> toJson() => {
+        'id': id,
+        'title': title,
+        'body': body,
+        'type': type,
+        'createdAt': createdAt.toIso8601String(),
+        'done': done,
+        'seen': seen,
+        'source': source,
+      };
+
+  factory MonitorItem.fromJson(Map<String, dynamic> j) => MonitorItem(
+        id: j['id']?.toString() ?? '',
+        title: j['title']?.toString() ?? '(untitled)',
+        body: j['body']?.toString() ?? '',
+        type: j['type']?.toString() ?? 'info',
+        createdAt:
+            DateTime.tryParse(j['createdAt']?.toString() ?? '') ??
+                DateTime.now(),
+        done: j['done'] == true,
+        seen: j['seen'] == true,
+        source: j['source']?.toString(),
+      );
+
+  /// Best-effort parse of an arbitrary remote JSON record into a MonitorItem.
+  /// Recognizes many common field name conventions so users can point the app
+  /// at their own REST API / Firebase RTDB without any server changes.
+  factory MonitorItem.fromRemote(dynamic raw, {String? source}) {
+    final j = raw is Map<String, dynamic> ? raw : <String, dynamic>{};
+    String pick(List<String> keys) {
+      for (final k in keys) {
+        final v = j[k];
+        if (v != null && v.toString().trim().isNotEmpty) return v.toString();
+      }
+      return '';
+    }
+
+    final idRaw = pick(['id', 'key', '_id', 'uid', 'uuid']);
+    final title = pick(['title', 'name', 'subject', 'heading', 'label']);
+    final body = pick([
+      'body', 'message', 'description', 'text', 'content', 'detail', 'details'
+    ]);
+    var type = pick(['type', 'level', 'severity', 'priority', 'kind'])
+        .toLowerCase();
+    if (type != 'alert' && type != 'warning' && type != 'success') type = 'info';
+
+    DateTime? dt;
+    for (final k in ['createdAt', 'created_at', 'timestamp', 'time', 'date', 'updated_at']) {
+      final v = j[k];
+      if (v == null) continue;
+      dt = DateTime.tryParse(v.toString()) ??
+          (v is num
+              ? DateTime.fromMillisecondsSinceEpoch(
+                  v > 9999999999 ? v.toInt() : (v.toInt() * 1000))
+              : null);
+      if (dt != null) break;
+    }
+
+    return MonitorItem(
+      id: idRaw.isNotEmpty ? idRaw : '${title.hashCode}-${j.hashCode}',
+      title: title.isNotEmpty ? title : '(untitled)',
+      body: body,
+      type: type,
+      createdAt: dt ?? DateTime.now(),
+      source: source,
+    );
+  }
+
+  @override
+  String toString() => jsonEncode(toJson());
+}
diff --git a/app/lib/services/background_worker.dart b/app/lib/services/background_worker.dart
new file mode 100644
index 0000000..9c6509a
--- /dev/null
+++ b/app/lib/services/background_worker.dart
@@ -0,0 +1,231 @@
+import 'dart:io';
+import 'package:flutter/foundation.dart';
+import 'package:flutter/material.dart' show Color;
+import 'package:flutter_local_notifications/flutter_local_notifications.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:workmanager/workmanager.dart';
+import '../models/monitor_item.dart';
+import '../services/storage_service.dart';
+import '../services/db_poller.dart';
+import '../services/widget_service.dart';
+
+/// Poll cadence shared by app, background worker and widget.
+const Duration kPollInterval = Duration(minutes: 15);
+
+@pragma('vm:entry-point')
+void callbackDispatcher() {
+  Workmanager().executeTask((task, inputData) async {
+    try {
+      await pollAndNotify(background: true);
+      await WidgetService.updateWidget();
+    } catch (e) {
+      if (kDebugMode) print('bg task error: $e');
+    }
+    return true;
+  });
+}
+
+/// One shared poll+notify routine used by the UI, the timer and the
+/// background worker. Returns the number of NEW items notified.
+Future<int> pollAndNotify({bool background = false}) async {
+  final (remote, err) = await DbPoller().fetchItems();
+  final s = StorageService();
+  await s.setLastPoll(DateTime.now());
+  if (err != null) return 0;
+
+  final stored = await s.loadItems();
+  final fresh = <MonitorItem>[];
+
+  // Merge: remote is the source of truth; keep local done/seen flags.
+  final byId = {for (final e in stored) e.id: e};
+  final merged = remote.map((r) {
+    final ex = byId[r.id];
+    if (ex == null) {
+      fresh.add(r);
+      return r;
+    }
+    return r.copyWith(done: ex.done, seen: ex.seen);
+  }).toList()
+    ..sort((a, b) => b.createdAt.compareTo(a.createdAt));
+
+  await s.saveItems(merged);
+
+  for (final item in fresh) {
+    await NotificationService.notifyItem(item);
+  }
+  await WidgetService.updateWidget();
+  return fresh.length;
+}
+
+/// Notification channels + showing, themed to Soft Day (terracotta).
+/// Channels are the "notification categories" the user asked about:
+///   alert   -> critical: sound + vibration, high priority
+///   warning -> sound, default priority
+///   info    -> silent
+///   success -> silent
+class NotificationService {
+  static final _plugin = FlutterLocalNotificationsPlugin();
+
+  static const _channelAlert = AndroidNotificationChannel(
+    'db_alert',
+    'Critical alerts',
+    description: 'Critical database alerts - sound and vibration',
+    importance: Importance.max,
+    playSound: true,
+    enableVibration: true,
+  );
+  static const _channelWarning = AndroidNotificationChannel(
+    'db_warning',
+    'Warnings',
+    description: 'Database warnings - sound',
+    importance: Importance.high,
+    playSound: true,
+  );
+  static const _channelInfo = AndroidNotificationChannel(
+    'db_info',
+    'Info',
+    description: 'Informational database updates - silent',
+    importance: Importance.low,
+    playSound: false,
+  );
+  static const _channelSuccess = AndroidNotificationChannel(
+    'db_success',
+    'Success',
+    description: 'Successful operations - silent',
+    importance: Importance.low,
+    playSound: false,
+  );
+
+  static Future<void> init() async {
+    const android = AndroidInitializationSettings('@mipmap/ic_launcher');
+    const settings = InitializationSettings(android: android);
+    await _plugin.initialize(
+      settings,
+      onDidReceiveNotificationResponse: (resp) {
+        // Tapping the notification opens the app (default launch intent).
+      },
+    );
+    await _createChannels();
+  }
+
+  static Future<void> _createChannels() async {
+    final impl = _plugin.resolvePlatformSpecificImplementation<
+        AndroidFlutterLocalNotificationsPlugin>();
+    await impl?.createNotificationChannel(_channelAlert);
+    await impl?.createNotificationChannel(_channelWarning);
+    await impl?.createNotificationChannel(_channelInfo);
+    await impl?.createNotificationChannel(_channelSuccess);
+  }
+
+  /// Android 13+ requires the POST_NOTIFICATIONS runtime permission.
+  /// Returns true when notifications are allowed (or on older Androids).
+  static Future<bool> requestPermission() async {
+    if (!Platform.isAndroid) return true;
+    final impl = _plugin.resolvePlatformSpecificImplementation<
+        AndroidFlutterLocalNotificationsPlugin>();
+    if (impl == null) return true;
+    final granted = await impl.requestNotificationsPermission();
+    return granted ?? true;
+  }
+
+  static Future<bool> isPermissionGranted() async {
+    if (!Platform.isAndroid) return true;
+    final impl = _plugin.resolvePlatformSpecificImplementation<
+        AndroidFlutterLocalNotificationsPlugin>();
+    return await impl?.areNotificationsEnabled() ?? true;
+  }
+
+  static (AndroidNotificationChannel, int, Priority) _channelFor(String type) {
+    switch (type) {
+      case 'alert':
+        return (_channelAlert, 2001, Priority.max);
+      case 'warning':
+        return (_channelWarning, 2002, Priority.high);
+      case 'success':
+        return (_channelSuccess, 2004, Priority.low);
+      default:
+        return (_channelInfo, 2003, Priority.low);
+    }
+  }
+
+  /// Show a properly styled notification for one item: themed color, small
+  /// icon matching the type, BigTextStyleInformation so long bodies are
+  /// readable, and a rounded-large-icon version of the app logo.
+  static Future<void> notifyItem(MonitorItem item) async {
+    final (channel, notifIdBase, priority) = _channelFor(item.type);
+    final id = item.id.hashCode & 0x7fffffff;
+    final details = AndroidNotificationDetails(
+      channel.id,
+      channel.name,
+      channelDescription: channel.description,
+      importance: channel.importance,
+      priority: priority,
+      color: const Color(0xFFC0684F), // Soft Day terracotta
+      largeIcon: const DrawableResourceAndroidBitmap('@mipmap/ic_launcher'),
+      styleInformation: BigTextStyleInformation(
+        item.body.isEmpty ? '(no details)' : item.body,
+        htmlFormatBigText: false,
+        contentTitle: item.title,
+        summaryText: 'DB Monitor - ${item.type}',
+      ),
+      category: AndroidNotificationCategory.status,
+      autoCancel: true,
+    );
+    await _plugin.show(
+      id,
+      item.title,
+      item.body.isEmpty ? '(no details)' : item.body,
+      NotificationDetails(android: details),
+    );
+  }
+
+  /// A gentle "check completed" summary (silent, info channel) so the user
+  /// can see the 15-minute cadence working even with no new items.
+  static Future<void> notifyCheckDone(
+      {int newItems = 0, bool silent = true}) async {
+    final p = await SharedPreferences.getInstance();
+    final enabled = p.getBool('notify_check_done') ?? false;
+    if (!enabled) return;
+    final details = AndroidNotificationDetails(
+      _channelInfo.id,
+      _channelInfo.name,
+      channelDescription: _channelInfo.description,
+      importance: Importance.low,
+      priority: Priority.low,
+      color: const Color(0xFFC0684F),
+      styleInformation: BigTextStyleInformation(
+        newItems > 0
+            ? '$newItems new item${newItems == 1 ? '' : 's'} found in the last check.'
+            : 'Check finished at ${DateTime.now().hour.toString().padLeft(2, '0')}:${DateTime.now().minute.toString().padLeft(2, '0')} - nothing new.',
+        contentTitle: newItems > 0 ? 'New database items' : 'Database checked',
+      ),
+      autoCancel: true,
+    );
+    await _plugin.show(
+      1999,
+      newItems > 0 ? 'New database items' : 'Database checked',
+      newItems > 0
+          ? '$newItems new item${newItems == 1 ? '' : 's'} found.'
+          : 'Nothing new since the last check.',
+      NotificationDetails(android: details),
+    );
+  }
+}
+
+/// Registers the 15-minute background poll with WorkManager.
+Future<void> registerPeriodicPoll() async {
+  try {
+    await Workmanager().initialize(callbackDispatcher);
+    await Workmanager().cancelByUniqueName('db-monitor-poll');
+    await Workmanager().registerPeriodicTask(
+      'db-monitor-poll',
+      'dbMonitorPoll',
+      frequency: kPollInterval, // 15 min = Android's minimum periodic interval
+      constraints: Constraints(networkType: NetworkType.connected),
+      existingWorkPolicy: ExistingWorkPolicy.replace,
+      backoffPolicy: BackoffPolicy.exponential,
+    );
+  } catch (_) {
+    // WorkManager can fail on odd devices; in-app timer still runs.
+  }
+}
diff --git a/app/lib/services/db_poller.dart b/app/lib/services/db_poller.dart
new file mode 100644
index 0000000..9c567aa
--- /dev/null
+++ b/app/lib/services/db_poller.dart
@@ -0,0 +1,135 @@
+import 'dart:convert';
+import 'package:http/http.dart' as http;
+import '../config/app_config.dart';
+import '../models/monitor_item.dart';
+import 'storage_service.dart';
+
+/// Fetches items from the configured REST API or Firebase Realtime Database.
+/// Falls back to a friendly preview set when nothing is configured, so the
+/// UI, notifications and widget are always demonstrable.
+class DbPoller {
+  Future<(List<MonitorItem>, String? err)> fetchItems() async {
+    final s = StorageService();
+    final apiUrl = (await s.getApiUrl()).trim();
+    final fbUrl = (await s.getFirebaseUrl()).trim();
+    final fbPath = (await s.getFirebasePath().then((p) =>
+            p.trim().isEmpty ? 'items' : p.trim()));
+
+    // REST API has priority when both are set.
+    if (apiUrl.isNotEmpty) {
+      return _fetchApi(apiUrl);
+    }
+    if (fbUrl.isNotEmpty) {
+      return _fetchFirebase(fbUrl, fbPath);
+    }
+    if (AppConfig.hasApiConfig) return _fetchApi(AppConfig.apiBaseUrl);
+    if (AppConfig.hasFirebaseConfig) {
+      return _fetchFirebase(AppConfig.firebaseDbUrl, fbPath);
+    }
+    return (previewItems(), null);
+  }
+
+  Future<(List<MonitorItem>, String? err)> _fetchApi(String url) async {
+    try {
+      final res = await http
+          .get(Uri.parse(url))
+          .timeout(const Duration(seconds: 20));
+      if (res.statusCode != 200) {
+        return (
+          <MonitorItem>[],
+          'API error ${res.statusCode}: ${res.reasonPhrase ?? ''}'.trim()
+        );
+      }
+      final data = jsonDecode(res.body);
+      return (_listFrom(data, source: 'api'), null);
+    } catch (e) {
+      return (<MonitorItem>[], 'API unreachable: $e');
+    }
+  }
+
+  Future<(List<MonitorItem>, String? err)> _fetchFirebase(
+      String url, String path) async {
+    try {
+      final uri = Uri.parse('$url/${path.trim().replaceAll(RegExp(r'^/+'), '')}.json');
+      final res =
+          await http.get(uri).timeout(const Duration(seconds: 20));
+      if (res.statusCode != 200) {
+        return (
+          <MonitorItem>[],
+          'Firebase error ${res.statusCode}: ${res.reasonPhrase ?? ''}'.trim()
+        );
+      }
+      final data = jsonDecode(res.body);
+      // RTDB returns a map keyed by push-id (or a list).
+      final list = data is Map
+          ? data.entries
+              .map((e) {
+                final m = Map<String, dynamic>.from(e.value as Map? ?? {});
+                m['key'] ??= e.key;
+                return m;
+              })
+              .toList()
+          : data;
+      return (_listFrom(list, source: 'firebase'), null);
+    } catch (e) {
+      return (<MonitorItem>[], 'Firebase unreachable: $e');
+    }
+  }
+
+  List<MonitorItem> _listFrom(dynamic data, {String? source}) {
+    List<dynamic> records = [];
+    if (data is List) {
+      records = data;
+    } else if (data is Map) {
+      // Unwrap common envelope keys; otherwise treat map values as the list.
+      for (final k in ['items', 'data', 'results', 'rows', 'records']) {
+        if (data[k] is List) {
+          records = data[k] as List;
+          break;
+        }
+      }
+      if (records.isEmpty && data.isNotEmpty) {
+        records = data.values.whereType<Map>().toList();
+      }
+    }
+    return records
+        .whereType<Map>()
+        .map((r) =>
+            MonitorItem.fromRemote(Map<String, dynamic>.from(r), source: source))
+        .toList();
+  }
+
+  /// Friendly sample content so a fresh install still shows the full UX.
+  List<MonitorItem> previewItems() {
+    final now = DateTime.now();
+    return [
+      MonitorItem(
+        id: 'preview-1',
+        title: 'Welcome to DB Monitor',
+        body: 'Connect your REST API or Firebase database in Settings to see '
+            'real items. Until then, this preview shows how alerts look.',
+        type: 'info',
+        createdAt: now,
+        source: 'preview',
+      ),
+      MonitorItem(
+        id: 'preview-2',
+        title: 'Checks run every 15 minutes',
+        body: 'The countdown card and the home-screen widget both show the '
+            'time until the next automatic check.',
+        type: 'success',
+        createdAt: now.subtract(const Duration(minutes: 1)),
+        source: 'preview',
+      ),
+      MonitorItem(
+        id: 'preview-3',
+        title: 'Notifications are grouped by type',
+        body: 'alert items ring and vibrate, warning items play a sound, '
+            'info and success items are silent.',
+        type: 'warning',
+        createdAt: now.subtract(const Duration(minutes: 2)),
+        source: 'preview',
+      ),
+    ];
+  }
+}
