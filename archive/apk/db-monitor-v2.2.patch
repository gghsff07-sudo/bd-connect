@@ -0,0 +1,111 @@
+package com.dbmonitor.db_monitor
+
+import android.appwidget.AppWidgetManager
+import android.appwidget.AppWidgetProvider
+import android.content.ComponentName
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import android.widget.RemoteViews
+import es.antonborri.home_widget.HomeWidgetPlugin
+
+/**
+ * Soft Day themed home-screen widget.
+ *
+ * Reads the values pushed by the Flutter side (WidgetService via home_widget):
+ *   pending        - Int    count of not-done items
+ *   nextCheckMs    - Long   epoch ms of the next 15-minute check
+ *   latestTitle    - String title of the newest item
+ *   lastPollLabel  - String "last: HH:mm"
+ *
+ * The countdown text + ring tick every second while the widget host keeps our
+ * views alive; the 30-minute updatePeriodMillis is only a fallback refresh.
+ */
+class SoftDayWidgetProvider : AppWidgetProvider() {
+
+    override fun onUpdate(
+        context: Context,
+        appWidgetManager: AppWidgetManager,
+        appWidgetIds: IntArray
+    ) {
+        for (id in appWidgetIds) {
+            val views = buildViews(context)
+            appWidgetManager.updateAppWidget(id, views)
+        }
+        scheduleTick(context)
+    }
+
+    override fun onEnabled(context: Context) {
+        scheduleTick(context)
+    }
+
+    override fun onDisabled(context: Context) {
+        tickHandler.removeCallbacksAndMessages(null)
+    }
+
+    override fun onDeleted(context: Context, appWidgetIds: IntArray?) {
+        super.onDeleted(context, appWidgetIds)
+        // Stop ticking when the last widget instance is gone.
+        val mgr = AppWidgetManager.getInstance(context)
+        val remaining = mgr.getAppWidgetIds(ComponentName(context, SoftDayWidgetProvider::class.java))
+        if (remaining.isEmpty()) {
+            tickHandler.removeCallbacksAndMessages(null)
+        }
+    }
+
+    private fun buildViews(context: Context): RemoteViews {
+        val views = RemoteViews(context.packageName, R.layout.soft_day_widget)
+        render(context, views)
+        return views
+    }
+
+    private fun render(context: Context, views: RemoteViews) {
+        val prefs = HomeWidgetPlugin.getData(context)
+        val pending = prefs.getInt("pending", 0)
+        val nextCheckMs = prefs.getLong("nextCheckMs", 0L)
+        val latestTitle = prefs.getString("latestTitle", null)
+        val lastPollLabel = prefs.getString("lastPollLabel", null)
+
+        val remainMs = if (nextCheckMs <= 0L) 0L else nextCheckMs - System.currentTimeMillis()
+        val totalSecs = ((remainMs / 1000L).coerceAtLeast(0L)).toInt()
+        val mm = (totalSecs / 60).coerceAtMost(99)
+        val ss = totalSecs % 60
+        views.setTextViewText(R.id.widget_countdown, String.format("%02d:%02d", mm, ss))
+
+        // Ring progress: 900 = full 15 minutes.
+        views.setProgressBar(R.id.widget_ring, 900, (totalSecs.coerceAtMost(900)), false)
+
+        views.setTextViewText(
+            R.id.widget_pending,
+            if (pending == 1) "1 pending item" else "$pending pending items"
+        )
+        views.setTextViewText(
+            R.id.widget_latest,
+            latestTitle?.takeIf { it.isNotBlank() } ?: (lastPollLabel ?: "waiting for first check…")
+        )
+    }
+
+    private fun scheduleTick(context: Context) {
+        tickHandler.removeCallbacks(tickRunnable)
+        tickRunnable = Runnable {
+            pushUpdate(context.applicationContext)
+            scheduleTick(context)
+        }
+        tickHandler.postDelayed(tickRunnable, 1000L)
+    }
+
+    private fun pushUpdate(context: Context) {
+        val mgr = AppWidgetManager.getInstance(context)
+        val ids = mgr.getAppWidgetIds(ComponentName(context, SoftDayWidgetProvider::class.java))
+        for (id in ids) {
+            val views = RemoteViews(context.packageName, R.layout.soft_day_widget)
+            render(context, views)
+            mgr.updateAppWidget(id, views)
+        }
+    }
+
+    companion object {
+        private val tickHandler = Handler(Looper.getMainLooper())
+        private var tickRunnable: Runnable = Runnable {}
+    }
+}
