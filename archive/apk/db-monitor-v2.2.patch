diff --git a/app/android/app/src/main/kotlin/com/dbmonitor/db_monitor/SoftDayWidgetProvider.kt b/app/android/app/src/main/kotlin/com/dbmonitor/db_monitor/SoftDayWidgetProvider.kt
new file mode 100644
