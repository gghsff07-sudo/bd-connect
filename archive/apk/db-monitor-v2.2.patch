+<?xml version="1.0" encoding="utf-8"?>
+<!-- Terracotta progress ring: cream track behind, terracotta sweep in front.
+     Layer 1 (background) is the track; the ring uses rotation-free layering so
+     ProgressBar handles the sweep. -->
+<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:id="@android:id/background">
+        <shape android:shape="ring"
+            android:innerRadiusRatio="2.6"
+            android:thicknessRatio="10"
+            android:useLevel="false">
+            <solid android:color="@color/widget_track"/>
+        </shape>
+    </item>
+    <item android:id="@android:id/progress">
+        <rotate
+            android:fromDegrees="270"
+            android:toDegrees="630">
+            <shape android:shape="ring"
+                android:innerRadiusRatio="2.6"
+                android:thicknessRatio="10"
+                android:useLevel="true">
+                <solid android:color="@color/widget_accent"/>
+            </shape>
+        </rotate>
+    </item>
+</layer-list>
diff --git a/app/android/app/src/main/res/layout/soft_day_widget.xml b/app/android/app/src/main/res/layout/soft_day_widget.xml
new file mode 100644
index 0000000..4e32fa8
--- /dev/null
+++ b/app/android/app/src/main/res/layout/soft_day_widget.xml
@@ -0,0 +1,94 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Soft Day themed home-screen widget.
+  Cream rounded card (#F8F4EE), terracotta ring + numbers (#C0684F),
+  charcoal heading (#2E2A26), warm gray labels (#8A8078).
+  The countdown text is updated by SoftDayWidgetProvider using a
+  Handler that ticks every second while the widget is visible.
+-->
+<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/widget_root"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:padding="8dp">
+
+    <LinearLayout
+        android:id="@+id/widget_card"
+        android:layout_width="match_parent"
+        android:layout_height="match_parent"
+        android:orientation="horizontal"
+        android:gravity="center_vertical"
+        android:background="@drawable/widget_card_bg"
+        android:paddingStart="18dp"
+        android:paddingEnd="18dp"
+        android:paddingTop="14dp"
+        android:paddingBottom="14dp">
+
+        <!-- Countdown ring (static drawable; value shown in the middle) -->
+        <FrameLayout
+            android:layout_width="62dp"
+            android:layout_height="62dp">
+
+            <ProgressBar
+                android:id="@+id/widget_ring"
+                style="?android:attr/progressBarStyleHorizontal"
+                android:layout_width="62dp"
+                android:layout_height="62dp"
+                android:progressDrawable="@drawable/widget_ring"
+                android:max="900"
+                android:progress="900"
+                android:indeterminate="false"/>
+
+            <TextView
+                android:id="@+id/widget_countdown"
+                android:layout_width="match_parent"
+                android:layout_height="match_parent"
+                android:gravity="center"
+                android:text="15:00"
+                android:textColor="@color/widget_heading"
+                android:textSize="14sp"
+                android:textStyle="bold"
+                android:fontFamily="sans-serif-medium"/>
+        </FrameLayout>
+
+        <LinearLayout
+            android:layout_width="0dp"
+            android:layout_height="wrap_content"
+            android:layout_weight="1"
+            android:layout_marginStart="16dp"
+            android:orientation="vertical">
+
+            <TextView
+                android:id="@+id/widget_title"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:text="DB MONITOR"
+                android:textColor="@color/widget_accent"
+                android:textSize="10sp"
+                android:letterSpacing="0.18"
+                android:textStyle="bold"/>
+
+            <TextView
+                android:id="@+id/widget_pending"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="2dp"
+                android:text="No pending items"
+                android:textColor="@color/widget_heading"
+                android:textSize="15sp"
+                android:textStyle="bold"
+                android:fontFamily="sans-serif-medium"/>
+
+            <TextView
+                android:id="@+id/widget_latest"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="2dp"
+                android:maxLines="1"
+                android:ellipsize="end"
+                android:text="last: not checked yet"
+                android:textColor="@color/widget_muted"
+                android:textSize="12sp"/>
+        </LinearLayout>
+    </LinearLayout>
+</FrameLayout>
