diff --git a/app/lib/config/app_config.dart b/app/lib/config/app_config.dart
new file mode 100644
index 0000000..6349161
--- /dev/null
+++ b/app/lib/config/app_config.dart
@@ -0,0 +1,19 @@
+/// Optional compile-time configuration. NEVER required: the app must start and
+/// work with all of these empty (preview mode). Users can also set values
+/// at runtime in Settings.
+class AppConfig {
+  // Leave empty for preview mode. If provided, used as defaults.
+  static const String apiBaseUrl = String.fromEnvironment('API_BASE_URL');
+  static const String firebaseDbUrl = String.fromEnvironment('FIREBASE_DB_URL');
+
+  static bool get hasApiConfig => apiBaseUrl.isNotEmpty;
+  static bool get hasFirebaseConfig => firebaseDbUrl.isNotEmpty;
+
+  /// Human-readable list of what was NOT provided (for the notice banner).
+  static List<String> get missingKeys {
+    final missing = <String>[];
+    if (!hasApiConfig) missing.add('API_BASE_URL');
+    if (!hasFirebaseConfig) missing.add('FIREBASE_DB_URL');
+    return missing;
+  }
+}
diff --git a/app/lib/config/theme.dart b/app/lib/config/theme.dart
new file mode 100644
index 0000000..9fc03e1
--- /dev/null
+++ b/app/lib/config/theme.dart
@@ -0,0 +1,81 @@
+/// "Soft Day" theme — warm cream + terracotta, from the user's reference image.
+/// Light mode only, soft shadows, very rounded cards. Used by app, notifications
+/// and widget so everything matches.
+library;
+
+import 'package:flutter/material.dart';
+
+class AppColors {
+  // Backgrounds
+  static const Color bg = Color(0xFFF0EAE2); // page background (warm cream)
+  static const Color card = Color(0xFFF8F4EE); // card surface
+  static const Color cardAlt = Color(0xFFFAF6F0);
+
+  // Brand accent (terracotta / clay)
+  static const Color accent = Color(0xFFC0684F);
+  static const Color accentDark = Color(0xFFB85C42);
+  static const Color accentSoft = Color(0xFFF3DDD5); // light accent fill
+
+  // Text
+  static const Color heading = Color(0xFF2E2A26); // warm charcoal
+  static const Color body = Color(0xFF3A3530);
+  static const Color muted = Color(0xFF8A8078); // warm gray
+  static const Color onAccent = Colors.white;
+  static const Color disabled = Color(0xFFC9C0B5);
+
+  // Toggles / tracks
+  static const Color trackOff = Color(0xFFD8D0C6);
+
+  // Type status colors (softened to fit the palette)
+  static const Color alert = Color(0xFFC0574F); // clay red
+  static const Color warning = Color(0xFFC98A3D); // warm amber
+  static const Color info = Color(0xFF7A8FA6); // soft slate blue
+  static const Color success = Color(0xFF7FA37A); // sage green
+
+  static Color typeColor(String type) {
+    switch (type) {
+      case 'alert':
+        return alert;
+      case 'warning':
+        return warning;
+      case 'success':
+        return success;
+      default:
+        return info;
+    }
+  }
+}
+
+/// Soft card with the theme's signature warm shadow + big radius.
+class SoftCard extends StatelessWidget {
+  final Widget child;
+  final EdgeInsetsGeometry padding;
+  final EdgeInsetsGeometry? margin;
+
+  const SoftCard({
+    super.key,
+    required this.child,
+    this.padding = const EdgeInsets.all(16),
+    this.margin,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    return Container(
+      margin: margin,
+      padding: padding,
+      decoration: BoxDecoration(
+        color: AppColors.card,
+        borderRadius: BorderRadius.circular(22),
+        boxShadow: const [
+          BoxShadow(
+            color: Color(0x2E96826E), // warm shadow rgba(150,130,110,0.18)
+            blurRadius: 18,
+            offset: Offset(0, 6),
+          ),
+        ],
+      ),
+      child: child,
+    );
+  }
+}
diff --git a/app/lib/main.dart b/app/lib/main.dart
new file mode 100644
index 0000000..cb74283
--- /dev/null
+++ b/app/lib/main.dart
@@ -0,0 +1,1114 @@
+import 'dart:async';
+import 'package:flutter/material.dart';
+import 'package:home_widget/home_widget.dart';
+import 'package:intl/intl.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'config/app_config.dart';
+import 'config/theme.dart';
+import 'models/monitor_item.dart';
+import 'services/background_worker.dart';
+import 'services/db_poller.dart';
+import 'services/storage_service.dart';
+import 'services/widget_service.dart';
+import 'widgets/countdown_ring.dart';
+import 'widgets/notification_permission_card.dart';
+
+void main() {
+  // Crash-proof entry: nothing in main() can throw - every init is guarded.
+  runApp(const DbMonitorApp());
+}
+
+class DbMonitorApp extends StatelessWidget {
+  const DbMonitorApp({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    return MaterialApp(
+      title: 'DB Monitor',
+      debugShowCheckedModeBanner: false,
+      theme: ThemeData(
+        useMaterial3: true,
+        colorScheme: ColorScheme.fromSeed(
+          seedColor: AppColors.accent,
+          surface: AppColors.card,
+        ),
+        scaffoldBackgroundColor: AppColors.bg,
+      ),
+      home: const HomeScreen(),
+    );
+  }
+}
+
+class HomeScreen extends StatefulWidget {
+  const HomeScreen({super.key});
+
+  @override
+  State<HomeScreen> createState() => _HomeScreenState();
+}
+
+class _HomeScreenState extends State<HomeScreen> with WidgetsBindingObserver {
+  List<MonitorItem> _items = [];
+  String? _lastError;
+  DateTime? _lastPoll;
+  Timer? _timer;
+  bool _checking = false;
+  bool _hasConfig = false;
+  bool _notifGranted = true;
+
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+    _bootstrap();
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    // Refresh when coming back to the app (e.g. after tapping the widget).
+    if (state == AppLifecycleState.resumed) _reload();
+  }
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    _timer?.cancel();
+    super.dispose();
+  }
+
+  Future<void> _bootstrap() async {
+    // All guarded - worst case the app shows an empty list, never crashes.
+    try {
+      await NotificationService.init();
+    } catch (_) {}
+    try {
+      final granted = await NotificationService.requestPermission();
+      if (mounted) setState(() => _notifGranted = granted);
+    } catch (_) {}
+    try {
+      await registerPeriodicPoll();
+    } catch (_) {}
+    try {
+      await HomeWidget.setAppGroupId('com.dbmonitor.db_monitor');
+    } catch (_) {}
+    await _reload();
+    _startInAppTimer();
+    await _checkNow(showNotifications: false, silent: true);
+  }
+
+  Future<void> _reload() async {
+    try {
+      final items = await StorageService().loadItems();
+      final last = await StorageService().getLastPoll();
+      final granted = await NotificationService.isPermissionGranted();
+      if (mounted) {
+        setState(() {
+          _items = items;
+          _lastPoll = last;
+          _notifGranted = granted;
+        });
+      }
+    } catch (_) {}
+    _loadConfigFlag();
+  }
+
+  void _loadConfigFlag() async {
+    final s = StorageService();
+    final api = await s.getApiUrl();
+    final fb = await s.getFirebaseUrl();
+    if (mounted) {
+      setState(() => _hasConfig = api.isNotEmpty ||
+          fb.isNotEmpty ||
+          AppConfig.hasApiConfig ||
+          AppConfig.hasFirebaseConfig);
+    }
+  }
+
+  void _startInAppTimer() {
+    _timer?.cancel();
+    // Foreground fallback poll, every 15 minutes.
+    _timer = Timer.periodic(kPollInterval, (_) => _checkNow());
+  }
+
+  Future<void> _checkNow(
+      {bool showNotifications = true, bool silent = false}) async {
+    if (_checking) return;
+    if (!silent) setState(() => _checking = true);
+    try {
+      final freshCount = await pollAndNotify();
+      final (remote, err) = await DbPoller().fetchItems();
+      if (!mounted) return;
+      setState(() {
+        _lastError = err;
+        _checking = false;
+        _lastPoll = DateTime.now();
+      });
+      // Reload merged state written by pollAndNotify.
+      await _reload();
+      if (freshCount > 0 && showNotifications) {
+        await NotificationService.notifyCheckDone(
+            newItems: freshCount, silent: true);
+      }
+    } catch (_) {
+      if (mounted) setState(() => _checking = false);
+    }
+  }
+
+  Future<void> _toggleDone(MonitorItem item) async {
+    final updated = item.copyWith(done: !item.done, seen: true);
+    final idx = _items.indexWhere((e) => e.id == item.id);
+    if (idx < 0) return;
+    setState(() => _items[idx] = updated);
+    await StorageService().saveItems(_items);
+    await WidgetService.updateWidget();
+  }
+
+  Future<void> _markSeen(MonitorItem item) async {
+    if (item.seen) return;
+    final updated = item.copyWith(seen: true);
+    final idx = _items.indexWhere((e) => e.id == item.id);
+    if (idx < 0) return;
+    setState(() => _items[idx] = updated);
+    await StorageService().saveItems(_items);
+  }
+
+  void _openDetail(MonitorItem item) {
+    _markSeen(item);
+    Navigator.of(context).push(MaterialPageRoute(
+      builder: (_) =>
+          DetailScreen(item: item, onToggleDone: () => _toggleDone(item)),
+    ));
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final pending = _items.where((i) => !i.done).length;
+    final missing = AppConfig.missingKeys;
+
+    return Scaffold(
+      backgroundColor: AppColors.bg,
+      appBar: AppBar(
+        backgroundColor: AppColors.bg,
+        elevation: 0,
+        scrolledUnderElevation: 0,
+        title: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            RichText(
+              text: const TextSpan(
+                style: TextStyle(
+                    fontSize: 20, fontWeight: FontWeight.w700, letterSpacing: 0.5),
+                children: [
+                  TextSpan(
+                      text: 'DB ',
+                      style: TextStyle(color: AppColors.heading)),
+                  TextSpan(
+                      text: 'MONITOR',
+                      style: TextStyle(color: AppColors.accent)),
+                ],
+              ),
+            ),
+            Text(
+              'checking every 15 minutes',
+              style: const TextStyle(
+                  fontSize: 11, letterSpacing: 1.2, color: AppColors.muted),
+            ),
+          ],
+        ),
+        actions: [
+          IconButton(
+            icon: _checking
+                ? const SizedBox(
+                    width: 18,
+                    height: 18,
+                    child: CircularProgressIndicator(
+                        strokeWidth: 2, color: AppColors.accent))
+                : const Icon(Icons.refresh, color: AppColors.heading),
+            onPressed: _checking ? null : _checkNow,
+          ),
+          IconButton(
+            icon: const Icon(Icons.settings_outlined, color: AppColors.heading),
+            onPressed: () async {
+              await Navigator.of(context).push(
+                  MaterialPageRoute(builder: (_) => const SettingsScreen()));
+              await _reload();
+              await _checkNow(showNotifications: false, silent: true);
+            },
+          ),
+        ],
+      ),
+      body: Column(
+        children: [
+          if (!_notifGranted)
+            NotificationPermissionCard(
+              granted: _notifGranted,
+              onRequest: () async {
+                final granted = await NotificationService.requestPermission();
+                setState(() => _notifGranted = granted);
+              },
+            ),
+          if (!_hasConfig || missing.isNotEmpty) _buildNoticeBanner(missing),
+          if (_lastError != null) _buildErrorBanner(_lastError!),
+          _buildCountdownCard(pending),
+          Expanded(child: _buildList()),
+        ],
+      ),
+      floatingActionButton: _items.isEmpty
+          ? null
+          : FloatingActionButton.extended(
+              backgroundColor: AppColors.accent,
+              foregroundColor: AppColors.onAccent,
+              elevation: 0,
+              icon: const Icon(Icons.done_all),
+              label: const Text('Mark all done'),
+              onPressed: () async {
+                final updated =
+                    _items.map((e) => e.copyWith(done: true)).toList();
+                setState(() => _items = updated);
+                await StorageService().saveItems(updated);
+                await WidgetService.updateWidget();
+              },
+            ),
+    );
+  }
+
+  Widget _buildCountdownCard(int pending) {
+    return SoftCard(
+      margin: const EdgeInsets.fromLTRB(16, 8, 16, 4),
+      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
+      child: Row(
+        children: [
+          CountdownRing(
+            lastPoll: _lastPoll,
+            onElapsed: () => _checkNow(),
+          ),
+          const SizedBox(width: 14),
+          Expanded(
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                const Text(
+                  'NEXT CHECK IN',
+                  style: TextStyle(
+                      fontSize: 10.5,
+                      letterSpacing: 1.6,
+                      fontWeight: FontWeight.w600,
+                      color: AppColors.muted),
+                ),
+                const SizedBox(height: 2),
+                Text(
+                  _checking ? 'Checking now…' : 'Auto-check countdown',
+                  style: const TextStyle(
+                      fontSize: 15.5,
+                      fontWeight: FontWeight.w600,
+                      color: AppColors.heading),
+                ),
+                const SizedBox(height: 2),
+                Text(
+                  'Pending $pending \u2022 '
+                  '${_lastPoll == null ? 'not checked yet' : 'last: ${DateFormat('HH:mm').format(_lastPoll!)}'}',
+                  style: const TextStyle(
+                      fontSize: 12, color: AppColors.muted),
+                ),
+              ],
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+
+  Widget _buildNoticeBanner(List<String> missing) {
+    return Container(
+      margin: const EdgeInsets.fromLTRB(16, 6, 16, 4),
+      padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
+      decoration: BoxDecoration(
+        color: AppColors.accentSoft,
+        borderRadius: BorderRadius.circular(16),
+      ),
+      child: Row(
+        children: [
+          const Icon(Icons.key_off, size: 19, color: AppColors.accentDark),
+          const SizedBox(width: 10),
+          Expanded(
+            child: Text(
+              missing.length >= 2
+                  ? 'Setup notice: no API / Firebase key provided \u2014 running in '
+                    'preview mode. Add your keys in Settings \u2192 Connect.'
+                  : 'Setup notice: ${missing.join(', ')} not provided. '
+                    'The app still works; those features are off.',
+              style: const TextStyle(
+                  fontSize: 12.5, color: AppColors.accentDark, height: 1.35),
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+
+  Widget _buildErrorBanner(String msg) {
+    return Container(
+      margin: const EdgeInsets.fromLTRB(16, 4, 16, 4),
+      padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 8),
+      decoration: BoxDecoration(
+        color: const Color(0xFFF6E3DF),
+        borderRadius: BorderRadius.circular(16),
+      ),
+      child: Row(
+        children: [
+          const Icon(Icons.cloud_off, size: 18, color: AppColors.alert),
+          const SizedBox(width: 8),
+          Expanded(
+            child: Text(msg,
+                maxLines: 2,
+                overflow: TextOverflow.ellipsis,
+                style: const TextStyle(
+                    fontSize: 12, color: AppColors.alert, height: 1.3)),
+          ),
+        ],
+      ),
+    );
+  }
+
+  Widget _buildList() {
+    if (_items.isEmpty) {
+      return _buildEmptyState();
+    }
+    return RefreshIndicator(
+      color: AppColors.accent,
+      onRefresh: () => _checkNow(),
+      child: ListView.builder(
+        padding: const EdgeInsets.only(bottom: 90, top: 4),
+        itemCount: _items.length,
+        itemBuilder: (context, i) => _ItemTile(
+          item: _items[i],
+          onTap: () => _openDetail(_items[i]),
+          onToggleDone: () => _toggleDone(_items[i]),
+        ),
+      ),
+    );
+  }
+
+  Widget _buildEmptyState() {
+    return Center(
+      child: Column(
+        mainAxisAlignment: MainAxisAlignment.center,
+        children: [
+          Container(
+            padding: const EdgeInsets.all(22),
+            decoration: const BoxDecoration(
+                color: AppColors.card, shape: BoxShape.circle),
+            child: Icon(Icons.mark_chat_unread_outlined,
+                size: 46, color: AppColors.accent),
+          ),
+          const SizedBox(height: 16),
+          const Text('No items yet',
+              style: TextStyle(
+                  fontSize: 17,
+                  fontWeight: FontWeight.w700,
+                  color: AppColors.heading)),
+          const SizedBox(height: 6),
+          SizedBox(
+            width: 280,
+            child: Text(
+              _hasConfig
+                  ? 'The database is checked every 15 minutes.\nNew items will appear here.'
+                  : 'Preview mode: add your API / Firebase details in Settings \u2192 '
+                    'Connect to monitor a real database.',
+              textAlign: TextAlign.center,
+              style: const TextStyle(
+                  fontSize: 13, color: AppColors.muted, height: 1.5),
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+}
+
+/// Soft-styled list tile: round type avatar, title, preview, time, done check.
+class _ItemTile extends StatelessWidget {
+  final MonitorItem item;
+  final VoidCallback onTap;
+  final VoidCallback onToggleDone;
+
+  const _ItemTile(
+      {required this.item, required this.onTap, required this.onToggleDone});
+
+  @override
+  Widget build(BuildContext context) {
+    final color = AppColors.typeColor(item.type);
+    return Container(
+      margin: const EdgeInsets.fromLTRB(16, 4, 16, 4),
+      child: Material(
+        color: AppColors.card,
+        borderRadius: BorderRadius.circular(20),
+        clipBehavior: Clip.antiAlias,
+        child: InkWell(
