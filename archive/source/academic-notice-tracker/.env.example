# ------------------------------------------------------------------
# Copy this file to `.env` and fill in the values before building.
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build
# time, so they must be present when you run `expo start` or a build.
# None of these values are secrets.
# ------------------------------------------------------------------

# The single Google account allowed to sign in. Must match the email
# baked into firestore.rules (OWNER_EMAIL) exactly.
EXPO_PUBLIC_OWNER_EMAIL=you@gmail.com

# OAuth "Web client" ID used by Google Sign-In.
# Firebase console -> Authentication -> Sign-in method -> Google
# -> Web SDK configuration -> Web client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
